# AcneVision AI Backend Configuration
PROJECT_NAME="AcneVision AI: Real-Time Acne Detection System"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,capacitor://localhost,http://localhost"

# AI/ML Model Configuration
# Supports YOLOv8 and YOLO11: .pt, .onnx, or .tflite
MODEL_PATH="weights/best_yolo11n_acne.pt"
MODEL_CONFIDENCE_THRESHOLD=0.35
MODEL_IOU_THRESHOLD=0.45
MODEL_DEVICE="cpu"  # "cpu", "cuda", "mps"
MODEL_HALF_PRECISION=false
INFERENCE_MAX_WORKERS=8

# External Classifier Handoff Microservice (FR-09)
CLASSIFIER_SERVICE_URL="http://localhost:8001/api/v1/classify"
CLASSIFIER_TIMEOUT_SECONDS=10.0
CLASSIFIER_FALLBACK_ENABLED=true

# Security & UU PDP Compliance
MAX_UPLOAD_SIZE_MB=15
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
STORE_FACIAL_IMAGES_ON_DISK=false  # STRICT UU PDP: In-memory only!

